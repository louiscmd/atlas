# Postgres. Locally: `npm run db:local` starts one on port 5433.
# On Vercel: set this to your hosted database (Neon / Vercel Postgres / Supabase).
DATABASE_URL="postgresql://forma:forma@localhost:5433/forma"
# Used by `prisma migrate`. Locally the same as DATABASE_URL; on Supabase the session pooler (port 5432).
DIRECT_URL="postgresql://forma:forma@localhost:5433/forma"
# Secret for hashing tokens / analytics actor ids. Change in production.
APP_SECRET="dev-only-change-me-0f9a8b7c6d5e4f3a2b1c"
APP_URL="http://localhost:3000"
# Optional: enables AI features (workout import, plan generation, food scanner, coach)
ANTHROPIC_API_KEY=""
# Optional OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""

# Development only: scanner returns a clearly-labelled sample when no AI key is set
FOOD_VISION_DEV_SAMPLE="0"
# Optional: override AI model (default claude-opus-5-5)
AI_MODEL=""
